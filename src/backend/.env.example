# ============================================
# ATLAS VIVO MILK - SWH Integration Environment
# ============================================
#
# Copy this file to .env and fill in the values
# NEVER commit the .env file to version control
#
# ============================================

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SWH API Configuration
SWH_API_BASE_URL=https://archive.softwareheritage.org/api/1
SWH_DEPOSIT_URL=https://deposit.softwareheritage.org/1
SWH_TIMEOUT=30000
SWH_RETRIES=3

# Forgejo/Codeberg Configuration
# Enable Forgejo integration
FORGEJO_ENABLED=true

# Codeberg API URL
FORGEJO_API_URL=https://codeberg.org/api/v1

# Your Codeberg namespace (organization/username)
FORGEJO_NAMESPACE=milkivc

# Your Codeberg Personal Access Token
# Generate at: https://codeberg.org/user/settings/applications
# Required permissions: repo, read:repo, write:repo
FORGEJO_ACCESS_TOKEN=your_codeberg_personal_access_token_here

# ============================================
# Compliance Configuration
# ============================================

# GDPR Compliance (default: true)
COMPLIANCE_GDPR=true

# EU Open Data Directive Compliance (default: true)
COMPLIANCE_EU_OPEN_DATA=true

# Portugal Admin Access Law Compliance (default: true)
COMPLIANCE_PT_ADMIN_ACCESS=true

# Academic Eligibility (FCT/ANI) (default: true)
COMPLIANCE_ACADEMIC_ELIGIBILITY=true

# Funding Eligibility (default: true)
COMPLIANCE_FUNDING_ELIGIBILITY=true

# ============================================
# Database Configuration (Optional - for future use)
# ============================================

# MongoDB Connection
# MONGODB_URI=mongodb://localhost:27017/atlas-vivo-milk

# PostgreSQL Connection
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=atlas_vivo_milk
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password

# ============================================
# External API Keys (Optional)
# ============================================

# GitHub API Token (for mirroring)
# GITHUB_TOKEN=your_github_token

# ORCID API Credentials
# ORCID_CLIENT_ID=your_orcid_client_id
# ORCID_CLIENT_SECRET=your_orcid_client_secret

# Zenodo API Token
# ZENODO_TOKEN=your_zenodo_token

# ============================================
# Security Configuration
# ============================================

# JWT Secret (for authentication)
# JWT_SECRET=your_jwt_secret_key

# Session Secret
# SESSION_SECRET=your_session_secret

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Email Configuration (Optional - for notifications)
# ============================================

# SMTP Settings
# SMTP_HOST=smtp.milk.pt
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@milk.pt
# SMTP_PASSWORD=your_smtp_password

# ============================================
# Monitoring & Analytics (Optional)
# ============================================

# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn

# Prometheus Metrics
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# ============================================
