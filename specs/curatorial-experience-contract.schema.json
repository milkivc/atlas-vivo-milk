{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.associacaomilk.pt/schemas/curatorial-experience-contract.schema.json",
  "title": "Atlas Vivo MILK Curatorial Experience Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_name",
    "source_evidence",
    "authorial_invariants",
    "experience_intent",
    "state_machine",
    "participant_actions",
    "system_responses",
    "sensory_dramaturgy",
    "territorial_binding",
    "physical_digital_relation",
    "accessibility_equivalents",
    "privacy_and_consent",
    "assets",
    "implementation_modules",
    "tests",
    "generic_fallback_allowed"
  ],
  "properties": {
    "canonical_name": {"type": "string", "minLength": 1},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "evidence"],
        "properties": {
          "source": {"type": "string"},
          "evidence": {"type": "string"},
          "location": {"type": ["string", "null"]}
        }
      }
    },
    "authorial_invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "experience_intent": {"type": "string", "minLength": 1},
    "state_machine": {
      "type": "object",
      "required": ["entry", "states", "transitions", "latency_or_return"],
      "properties": {
        "entry": {"type": "string"},
        "states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "transitions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "latency_or_return": {"type": "string"}
      }
    },
    "participant_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "system_responses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "ludic_logic": {
      "type": ["object", "null"],
      "properties": {
        "mode": {"enum": ["brincar", "convite", "tentar_a_sorte", "ritual", "nao_ludico"]},
        "rules": {"type": "array", "items": {"type": "string"}},
        "chance_or_uncertainty": {"type": ["string", "null"]},
        "collective_or_singular": {"type": ["string", "null"]}
      }
    },
    "sensory_dramaturgy": {
      "type": "object",
      "required": ["visual", "sound", "movement", "time", "silence_or_absence", "surprise"],
      "properties": {
        "visual": {"type": "array", "items": {"type": "string"}},
        "sound": {"type": "array", "items": {"type": "string"}},
        "movement": {"type": "array", "items": {"type": "string"}},
        "time": {"type": "array", "items": {"type": "string"}},
        "silence_or_absence": {"type": "array", "items": {"type": "string"}},
        "surprise": {"type": "array", "items": {"type": "string"}},
        "voice_or_transcription": {"type": "array", "items": {"type": "string"}},
        "haptic_or_device_feedback": {"type": "array", "items": {"type": "string"}}
      }
    },
    "territorial_binding": {
      "type": "object",
      "required": ["copernico_relation", "freguesia_relation"],
      "properties": {
        "copernico_relation": {"type": "string"},
        "freguesia_relation": {"type": "string"},
        "data_dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "physical_digital_relation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "accessibility_equivalents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "privacy_and_consent": {"type": "array", "items": {"type": "string"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "source_status"],
        "properties": {
          "role": {"type": "string"},
          "path_or_identifier": {"type": ["string", "null"]},
          "source_status": {"enum": ["official", "required_missing", "generated_effect_only", "not_required"]}
        }
      }
    },
    "implementation_modules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mistral_capabilities": {
      "type": "array",
      "items": {"enum": ["document_library", "ocr", "code_interpreter", "handoffs", "structured_output", "vibe_code", "voxtral_stt", "voxtral_realtime", "voxtral_tts", "vision", "connectors_mcp", "function_calling", "none"]}
    },
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "generic_fallback_allowed": {"const": false}
  }
}
